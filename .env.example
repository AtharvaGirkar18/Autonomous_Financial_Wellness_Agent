# ── Option A: Google Gemini (recommended) ─────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
LLM_PROVIDER=google
MODEL_NAME=gemini-3.8-flash
GOOGLE_API_KEY=your_gemini_key_here

# ── Option B: Grok by xAI (free tier, good fallback when Gemini is overloaded) ─
# Get a free key at https://console.x.ai
# Set LLM_PROVIDER=grok and paste your XAI_API_KEY below (leave GOOGLE_API_KEY blank)
# LLM_PROVIDER=grok
# MODEL_NAME=grok-3-mini
XAI_API_KEY=

# ── Option C: OpenAI-compatible endpoint ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

DATABASE_URL=
